# ===================================================
# KPRM2 Platform (Go Edition) Environment Configuration
# ===================================================

# Port to run Go server on
PORT=8080

# Database Settings (Compatible with existing KPRM2 MySQL database)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kprm2_db
DB_USER=root
DB_PASS=

# Environment (production or development)
APP_ENV=development
APP_URL=http://localhost:8080

# Session Secret Key
SECRET_KEY=kprm2_super_secret_session_encryption_key_2026

# Uploads directory (relative or absolute, default shares with PHP uploads)
UPLOAD_PATH=../uploads

